rules_version = '2';

// Cat Paws Arena, Firestore in europe-west1 (docs/contract.md §7).
// Checklist: backend/SECURITY_RULES.md. Tests: backend/test/rules.test.js.
// Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function exactKeys(data, keys) {
      return data.keys().hasOnly(keys) && data.keys().hasAll(keys);
    }

    // Same limits as CloudProfile: <= 64 chars, no control characters.
    function shortId(s) {
      return s is string && s.matches('^[^\\x00-\\x1F\\x7F]{0,64}$');
    }

    function inRange(v, count) {
      return v is int && v >= 0 && v < count;
    }

    // Must match CloudProfile in lib/online/cloud_profile.dart; a Dart test
    // checks the option counts below against it.
    function validProfile(d) {
      return exactKeys(d, ['schemaVersion', 'revision', 'trophies', 'coins',
            'cat', 'accessory', 'fur', 'eyes', 'ears', 'pattern', 'power',
            'owned', 'claims', 'daily', 'sfx', 'music', 'english',
            'notifications', 'avatar', 'roadClaims', 'unlockedEmotes'])
        && d.schemaVersion == 2
        && d.revision is int
        && d.trophies is int && d.trophies >= 0
        && d.coins is int && d.coins >= 0
        && d.cat in ['Tzuki', 'Bubble', 'Custom']
        && shortId(d.accessory)
        && inRange(d.fur, 6)
        && inRange(d.eyes, 4)
        && inRange(d.ears, 4)
        && inRange(d.pattern, 5)
        && inRange(d.power, 3)
        && d.owned is list && d.owned.size() <= 512
        && d.claims is list && d.claims.size() <= 512
        // Trophy road: up to ~800 claimed thresholds + the few emotes
        // the road can unlock. Wire values are short preset ids.
        && d.roadClaims is list && d.roadClaims.size() <= 1024
        && d.unlockedEmotes is list && d.unlockedEmotes.size() <= 16
        && shortId(d.daily)
        && d.sfx is bool && d.music is bool
        && d.english is bool && d.notifications is bool
        && d.avatar is string && d.avatar.size() <= 512;
    }

    // Cloud save. Private to its owner; never shown to other players.
    match /users/{uid} {
      allow get, delete: if isUser(uid);
      allow create: if isUser(uid) && validProfile(request.resource.data)
        && request.resource.data.revision == 1;
      allow update: if isUser(uid) && validProfile(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1;

      // Your-turn push target (Firebase installation ID) of one install.
      match /devices/{installId} {
        allow get, list, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && installId.matches('^[a-z0-9]{20}$')
          && exactKeys(request.resource.data, ['fid', 'platform', 'updatedAt'])
          && request.resource.data.fid is string
          && request.resource.data.fid.size() <= 256
          && request.resource.data.platform == 'android'
          && request.resource.data.updatedAt == request.time;
      }
    }

    // Server-time probe for FirestoreCloudStore.syncClock.
    match /clocks/{uid} {
      allow get, delete: if isUser(uid);
      allow create, update: if isUser(uid)
        && exactKeys(request.resource.data, ['t'])
        && request.resource.data.t == request.time;
    }

    function roomLifetime() {
      return duration.value(24, 'h');
    }

    function matchIdFor(code, room) {
      return code + '_' + string(room.createdAt.toMillis());
    }

    // True when this request also creates the match that claims the room.
    function claimedByMe(code, room) {
      let path = /databases/$(database)/documents/matches/$(matchIdFor(code, room));
      return existsAfter(path) && getAfter(path).data.guestUid == request.auth.uid;
    }

    // Friend room codes. Get by exact code only; no listing others' rooms.
    match /rooms/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.hostUid == request.auth.uid;
      allow create: if signedIn()
        && code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{6}$')
        && request.resource.data.keys().hasOnly(['hostUid', 'createdAt', 'expiresAt', 'power'])
        && request.resource.data.keys().hasAll(['hostUid', 'createdAt', 'expiresAt'])
        && (!('power' in request.resource.data) || inRange(request.resource.data.power, 3))
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time + duration.value(23, 'h')
        && request.resource.data.expiresAt < request.time + duration.value(25, 'h');
      allow update: if false;
      allow delete: if signedIn() && (
        resource.data.hostUid == request.auth.uid
        || request.time >= resource.data.createdAt + roomLifetime()
        || claimedByMe(code, resource.data));
    }

    // PowerKind order in arena_engine: zoomies, shadowPounce, laserChase.
    function powerName(i) {
      return i == 0 ? 'zoomies' : (i == 1 ? 'shadowPounce' : 'laserChase');
    }

    // The agreed timed-turn duel fingerprint; the loadout part names each
    // player's chosen power (MatchConfig.fingerprint in the engine).
    // v6 = Variant B "Frenzy": simultaneous 60 s duel, 15 s Fever x2.
    function duelFingerprint(p1, p2) {
      return 'v6|7x7|c5|t1/60s|sim=true/60s/f15|rainbow:clearOneColour'
        + '|powers:threeFreeEqual|loadout:'
        + powerName(p1) + '/' + powerName(p2);
    }

    // Created only in the room-claim transaction, which deletes the room in
    // the same commit, so one room makes at most one match.
    function validClaim(matchId, d) {
      let roomPath = /databases/$(database)/documents/rooms/$(d.roomCode);
      return d.keys().hasOnly(['roomCode', 'hostUid', 'guestUid', 'createdAt',
            'seed', 'config', 'engineVersion', 'contractVersion',
            'power1', 'power2'])
        && d.keys().hasAll(['roomCode', 'hostUid', 'guestUid', 'createdAt',
            'seed', 'config', 'engineVersion', 'contractVersion'])
        && d.roomCode is string
        && d.seed is int && d.seed >= 0 && d.seed < 2147483648
        && (!('power1' in d) || inRange(d.power1, 3))
        && (!('power2' in d) || inRange(d.power2, 3))
        && d.config == duelFingerprint(
            ('power1' in d) ? d.power1 : 0,
            ('power2' in d) ? d.power2 : 0)
        && d.engineVersion == 6
        && d.contractVersion == 1
        && exists(roomPath)
        && !existsAfter(roomPath)
        && d.guestUid == request.auth.uid
        && d.hostUid == get(roomPath).data.hostUid
        && d.hostUid != d.guestUid
        && d.createdAt == request.time
        && request.time < get(roomPath).data.createdAt + roomLifetime()
        && matchId == matchIdFor(d.roomCode, get(roomPath).data);
    }

    function isPlayer(m) {
      return signedIn()
        && request.auth.uid in [m.data.hostUid, m.data.guestUid];
    }

    function isPlayerOf(matchId) {
      return isPlayer(get(/databases/$(database)/documents/matches/$(matchId)));
    }

    // Only the two players. A missing match can be watched by its ID (the
    // host waits for the guest) but reveals nothing.
    // The host plays 'first', the guest 'second'.
    function slotOf(m) {
      return request.auth.uid == m.data.hostUid ? 'first' : 'second';
    }

    function moveId(i) {
      return i < 10 ? '00' + string(i) : (i < 100 ? '0' + string(i) : string(i));
    }

    function movePath(matchId, id) {
      return /databases/$(database)/documents/matches/$(matchId)/moves/$(id);
    }

    function validCell(c) {
      return c is map && exactKeys(c, ['row', 'col'])
        && inRange(c.row, 7) && inRange(c.col, 7);
    }

    // Move.toJson() from arena_engine; no strings except enum names.
    // Simultaneous (Frenzy) swaps/powers may name their slot in `player`;
    // `tick` is the host-written clock second of a simultaneous match.
    function validMove(m) {
      return m is map && (
        (m.kind == 'swap'
          && m.keys().hasAll(['kind', 'a', 'b'])
          && m.keys().hasOnly(['kind', 'a', 'b', 'player'])
          && validCell(m.a) && validCell(m.b)
          && (!('player' in m) || m.player in ['first', 'second']))
        || (m.kind == 'power'
          && m.keys().hasAll(['kind', 'power'])
          && m.keys().hasOnly(['kind', 'power', 'row', 'player'])
          && m.power in ['zoomies', 'shadowPounce', 'laserChase']
          && (!('row' in m) || inRange(m.row, 7))
          && (!('player' in m) || m.player in ['first', 'second']))
        || (m.kind == 'endTurn' && exactKeys(m, ['kind']))
        || (m.kind == 'tick' && exactKeys(m, ['kind'])));
    }

    function hash16(h) {
      return h is string && h.matches('^[0-9a-f]{16}$');
    }

    function validFinal(f) {
      return f is map && exactKeys(f, ['first', 'second', 'hash', 'outcome'])
        && f.first is int && f.first >= 0 && f.second is int && f.second >= 0
        && hash16(f.hash)
        && f.outcome in ['firstWins', 'secondWins', 'draw'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Each player writes their own result once.
    function finalUpdate() {
      let key = 'final_' + slotOf(resource);
      return changedKeys().hasOnly([key]) && !(key in resource.data)
        && validFinal(request.resource.data[key]);
    }

    // Any player may flag once; a flag is never cleared.
    function flagUpdate() {
      return changedKeys().hasOnly(['flag']) && !('flag' in resource.data)
        && request.resource.data.flag in ['hash_mismatch', 'invalid_move',
          'wrong_turn', 'bad_log', 'unknown_version', 'final_mismatch'];
    }

    // Slow play: the last move handed the turn to the opponent at least
    // 24 hours ago. existsAfter: no move may join the same batch.
    function forfeitUpdate(matchId) {
      let d = request.resource.data;
      let last = get(movePath(matchId, d.forfeitAfter)).data;
      return changedKeys().hasOnly(['forfeitWinner', 'forfeitAfter'])
        && !('forfeitWinner' in resource.data)
        && d.forfeitWinner == slotOf(resource)
        && d.forfeitAfter is string
        && last.next == (slotOf(resource) == 'first' ? 'second' : 'first')
        && request.time >= last.at + duration.value(24, 'h')
        && !existsAfter(movePath(matchId, moveId(last.index + 1)));
    }

    match /matches/{matchId} {
      allow get: if signedIn() && (resource == null || isPlayer(resource));
      allow list: if false;
      allow create: if signedIn() && validClaim(matchId, request.resource.data);
      allow update: if isPlayer(resource)
        && (finalUpdate() || flagUpdate() || forfeitUpdate(matchId));
      allow delete: if false;

      // Ordered, create-only move log. Rules cannot run the engine: each
      // phone replays the other's moves and flags a mismatch.
      match /moves/{id} {
        allow read: if isPlayerOf(matchId);
        allow create: if isPlayerOf(matchId)
          && exactKeys(request.resource.data,
            ['index', 'by', 'slot', 'move', 'hashAfter', 'next', 'at'])
          && inRange(request.resource.data.index, 500)
          && id == moveId(request.resource.data.index)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.slot == slotOf(
            get(/databases/$(database)/documents/matches/$(matchId)))
          && hash16(request.resource.data.hashAfter)
          && request.resource.data.next in ['first', 'second', 'none']
          && request.resource.data.at == request.time
          && validMove(request.resource.data.move)
          && (request.resource.data.index == 0
            || exists(movePath(matchId, moveId(request.resource.data.index - 1))))
          && !('forfeitWinner' in
            getAfter(/databases/$(database)/documents/matches/$(matchId)).data);
        allow update, delete: if false;
      }

      // Preset emotes only (lib/online/emotes.dart). No text reaches the
      // other player.
      match /emotes/{emoteId} {
        allow read: if isPlayerOf(matchId);
        allow create: if isPlayerOf(matchId)
          && exactKeys(request.resource.data, ['emote', 'from', 'at'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.emote in
            ['hello', 'good_game', 'wow', 'oops', 'thanks', 'purr',
             'love', 'angry'];
        allow update, delete: if false;
      }
    }
  }
}
